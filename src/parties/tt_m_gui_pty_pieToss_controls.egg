<Comment> {
  "egg-texture-cards -o tt_m_gui_pty_pieToss_controls.egg ../maps/tt_t_gui_pty_pieToss_arrowkeys.tif ../maps/tt_t_gui_pty_pieToss_controlkey.tif"
}
<Texture> tt_t_gui_pty_pieToss_controlkey {
  "../maps/tt_t_gui_pty_pieToss_controlkey.tif"
}
<Texture> tt_t_gui_pty_pieToss_arrowkeys {
  "../maps/tt_t_gui_pty_pieToss_arrowkeys.tif"
}
<Group> {
  <Switch> { 1 }
  <Scalar> fps { 2 }
  <VertexPool> vpool {
    <Vertex> 0 {
      -0.5 0.5 0
      <UV> { 0 1 }
    }
    <Vertex> 1 {
      -0.5 -0.5 0
      <UV> { 0 0 }
    }
    <Vertex> 2 {
      0.5 -0.5 0
      <UV> { 1 0 }
    }
    <Vertex> 3 {
      0.5 0.5 0
      <UV> { 1 1 }
    }
  }
  <Group> tt_t_gui_pty_pieToss_arrowkeys {
    <Polygon> {
      <RGBA> { 1 1 1 1 }
      <TRef> { tt_t_gui_pty_pieToss_arrowkeys }
      <VertexRef> { 0 1 2 3 <Ref> { vpool } }
    }
  }
  <Group> tt_t_gui_pty_pieToss_controlkey {
    <Polygon> {
      <RGBA> { 1 1 1 1 }
      <TRef> { tt_t_gui_pty_pieToss_controlkey }
      <VertexRef> { 0 1 2 3 <Ref> { vpool } }
    }
  }
}
